{
  "manifest_version": 3,
  "name": "TapTap 制造 · 输入与积分统计",
  "version": "0.9.69",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "description": "记录你在 TapTap 制造（maker.taptap.cn）的每次输入与积分消耗，侧边栏实时显示当前登录用户各项积分余额。数据全部保存在本机浏览器。",
  "permissions": ["storage", "sidePanel", "downloads", "scripting"],
  "host_permissions": ["https://maker.taptap.cn/*", "https://ntfy.sh/*", "https://api.day.app/*", "https://developer.taptap.cn/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TapTap 制造统计（点击打开侧边栏）",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://maker.taptap.cn/*"],
      "js": ["main-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://maker.taptap.cn/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
